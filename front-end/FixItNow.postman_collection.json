{
  "info": {
    "_postman_id": "b7e1a2c3-4d5e-6f70-8a9b-0c1d2e3f4a5b",
    "name": "FixItNow API",
    "description": "Complete API collection for the FixItNow home-service marketplace.\n\n**Setup:**\n1. Set the `base-url` collection variable (default `http://localhost:5000/api`).\n2. Run **Auth → Login** — the access token is saved automatically into `accessToken`.\n3. All protected requests use Bearer `{{accessToken}}` (cookies also work).\n\nDocs: see `server/api.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "base-url", "value": "http://localhost:5000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "serviceId", "value": "" },
    { "key": "technicianId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "categoryId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Server health check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base-url}}", "host": ["{{base-url}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane.smith@example.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"CUSTOMER\",\n  \"phone\": \"+1234567890\",\n  \"address\": \"789 Maple Drive, Austin, TX\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base-url}}/auth/register",
              "host": ["{{base-url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register technician",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"David Chen\",\n  \"email\": \"david.chen@example.com\",\n  \"password\": \"securePassword123\",\n  \"role\": \"TECHNICIAN\",\n  \"phone\": \"+1234567891\",\n  \"address\": \"12 Green Road, Dhaka\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base-url}}/auth/register",
              "host": ["{{base-url}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Login (saves accessToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "  pm.test('token saved', function () { pm.expect(json.data.accessToken).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.smith@example.com\",\n  \"password\": \"securePassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base-url}}/auth/login",
              "host": ["{{base-url}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
