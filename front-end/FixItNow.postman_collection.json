    {
      "name": "Bookings",
      "item": [
        {
          "name": "Get available slots (date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.length) {",
                  "  const s = json.data[0];",
                  "  const t12 = (t) => { const [h, m] = t.split(':'); const p = +h >= 12 ? 'PM' : 'AM'; const hh = +h % 12 || 12; return String(hh).padStart(2, '0') + ':' + m + ' ' + p; };",
                  "  pm.collectionVariables.set('scheduledTime', t12(s.start) + ' - ' + t12(s.end));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base-url}}/bookings/availability?technicianId={{technicianId}}&date=2026-09-07",
              "host": ["{{base-url}}"],
              "path": ["bookings", "availability"],
              "query": [
                { "key": "technicianId", "value": "{{technicianId}}" },
                { "key": "date", "value": "2026-09-07", "description": "YYYY-MM-DD" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create booking (saves bookingId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.id) pm.collectionVariables.set('bookingId', json.data.id);",
                  "pm.test('booking created or conflict', function () {",
                  "  pm.expect([200, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": \"{{serviceId}}\",\n  \"technicianId\": \"{{technicianId}}\",\n  \"scheduledDate\": \"2026-09-07T00:00:00.000Z\",\n  \"scheduledTime\": \"{{scheduledTime}}\",\n  \"totalPrice\": 2500,\n  \"customerAddress\": \"House 12, Road 5, Dhanmondi, Dhaka\",\n  \"notes\": \"Please call before arriving\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base-url}}/bookings",
              "host": ["{{base-url}}"],
              "path": ["bookings"]
            },
            "description": "Creates a REQUESTED booking + PENDING payment. Emails go to customer AND technician. Re-running with the same date/time returns 409 Conflict (slot already booked)."
          },
          "response": []
        },
        {
          "name": "My bookings",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base-url}}/bookings",
              "host": ["{{base-url}}"],
              "path": ["bookings"]
            }
          },
          "response": []
        },
