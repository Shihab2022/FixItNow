<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style type="text/css">
      .button-container { margin: 28px 0; text-align: center; }
      a { color: #2563eb; text-decoration: none; }
      a:hover { opacity: 0.9 !important; }
      body, td, p, h1, h2, h3 {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      }
    </style>
  </head>
  <body
    marginheight="0"
    topmargin="0"
    marginwidth="0"
    leftmargin="0"
    style="margin: 0; padding: 0; background-color: #f8fafc;"
  >
    <table
      role="presentation"
      cellspacing="0"
      border="0"
      cellpadding="0"
      width="100%"
      bgcolor="#f8fafc"
      style="background-color: #f8fafc;"
    >
      <tr>
        <td align="center" style="padding: 24px 0;">
          <table
            role="presentation"
            width="100%"
            border="0"
            align="center"
            cellpadding="0"
            cellspacing="0"
            style="max-width: 600px;"
          >
            <!-- Brand mark -->
            <tr>
              <td align="center" style="padding: 12px 0 8px 0;">
                <a
                  href="<%= baseUrl %>"
                  title="FixItNow"
                  target="_blank"
                  style="text-decoration: none; font-size: 26px; font-weight: 800; color: #0f172a; letter-spacing: -0.5px;"
                >
                  FixIt<span style="color: #2563eb;">Now</span>
                </a>
              </td>
            </tr>
            <tr>
              <td style="height: 20px;">&nbsp;</td>
            </tr>
            <!-- White content card -->
            <tr>
              <td>
                <table
                  role="presentation"
                  width="100%"
                  border="0"
                  align="center"
                  cellpadding="0"
                  cellspacing="0"
                  style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);"
                >
                  <!-- Title block (opened here; body content + footer continue below) -->
                  <tr>
                    <td style="padding: 32px 36px;">
                      <h1
                        style="color: #0f172a; font-weight: 700; margin: 0 0 12px 0; font-size: 24px; text-align: center;"
                      >
                        <%= title %>
                      </h1>
                      <div style="text-align: center; margin: 6px 0 26px;">
                        <span
                          style="display: inline-block; border-bottom: 2px solid #2563eb; width: 60px;"
                        ></span>
                      </div>
