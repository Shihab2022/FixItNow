<%- include('layouts/emailHeader', { title: 'A Technician Wants to Work on Your Task', baseUrl: baseUrl }) %>

<p style="color:#334155; font-size:15px; line-height:24px; margin:0 0 16px;">
  Hi <strong><%= customerName %></strong>,
</p>

<p style="color:#334155; font-size:15px; line-height:24px; margin:0 0 24px;">
  The following technician is interested in your task <strong>"<%= taskTitle %>"</strong> (<%= categoryName %>).
  Review their profile below and book them if they look like a good fit.
</p>

<table
  role="presentation"
  width="100%"
  border="0"
  cellpadding="0"
  cellspacing="0"
  style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; margin: 0 0 24px;"
>
  <tr>
    <td style="padding: 20px 24px;">
      <h2 style="margin:0 0 12px 0; color:#0f172a; font-size:18px; font-weight:700;">
        <%= technicianName %>
      </h2>
      <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size:14px; color:#334155;">
        <tr>
          <td style="padding:4px 0; color:#64748b; width:120px;">Skills</td>
          <td style="padding:4px 0; font-weight:600;"><%= skills || 'General' %></td>
        </tr>
        <tr>
          <td style="padding:4px 0; color:#64748b; width:120px;">Experience</td>
          <td style="padding:4px 0; font-weight:600;"><%= experience %> years</td>
        </tr>
        <tr>
          <td style="padding:4px 0; color:#64748b; width:120px;">Hourly rate</td>
          <td style="padding:4px 0; font-weight:600;"><%= hourlyRate %></td>
        </tr>
        <tr>
          <td style="padding:4px 0; color:#64748b; width:120px;">Rating</td>
          <td style="padding:4px 0; font-weight:600;">★ <%= rating %> / 5</td>
        </tr>
        <% if (message) { %>
        <tr>
          <td style="padding:8px 0 0 0; color:#64748b; width:120px; vertical-align:top;">Message</td>
          <td style="padding:8px 0 0 0; font-weight:500; font-style:italic;"><%= message %></td>
        </tr>
        <% } %>
      </table>
    </td>
  </tr>
</table>

<%- include('components/button', { text: 'View Technician Details', url: technicianUrl }) %>

<p style="color:#334155; font-size:15px; line-height:24px; margin:0 0 24px;">
  After reviewing the technician you can book an appointment directly from their profile.
</p>

<%- include('layouts/emailFooter', { baseUrl: baseUrl }) %>