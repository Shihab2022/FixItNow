<div
  style="
    background-color: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 8px;
    padding: 20px;
    margin: 20px 0;
  "
>
  <h3
    style="
      margin: 0 0 12px 0;
      color: #166534;
      font-size: 15px;
      font-weight: 700;
      border-bottom: 1px solid #bbf7d0;
      padding-bottom: 8px;
    "
  >
    Payment Information
  </h3>
  <table
    width="100%"
    border="0"
    cellpadding="0"
    cellspacing="0"
    style="font-size: 14px; color: #166534"
  >
    <tr>
      <td style="padding: 4px 0; font-weight: 600; width: 35%">Amount:</td>
      <td style="padding: 4px 0; font-weight: 700"><%= amount %></td>
    </tr>
    <tr>
      <td style="padding: 4px 0; font-weight: 600">Transaction ID:</td>
      <td style="padding: 4px 0; font-family: monospace">
        <%= transactionId %>
      </td>
    </tr>
    <tr>
      <td style="padding: 4px 0; font-weight: 600">Status:</td>
      <td style="padding: 4px 0">Successful</td>
    </tr>
  </table>
</div>
