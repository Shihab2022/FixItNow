<div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin: 20px 0;">
  <h3 style="margin: 0 0 12px 0; color: #0f172a; font-size: 15px; font-weight: 700; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
    Booking Details
  </h3>
  <table width="100%" border="0" cellpadding="0" cellspacing="0" style="font-size: 14px; color: #334155;">
    <% if (typeof serviceTitle !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600; width: 35%;">Service:</td>
      <td style="padding: 4px 0;"><%= serviceTitle %></td>
    </tr>
    <% } %>
    <% if (typeof customerName !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Customer:</td>
      <td style="padding: 4px 0;"><%= customerName %></td>
    </tr>
    <% } %>
    <% if (typeof technicianName !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Technician:</td>
      <td style="padding: 4px 0;"><%= technicianName %></td>
    </tr>
    <% } %>
    <% if (typeof scheduledDate !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Date:</td>
      <td style="padding: 4px 0;"><%= scheduledDate %></td>
    </tr>
    <% } %>
    <% if (typeof scheduledTime !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Time:</td>
      <td style="padding: 4px 0;"><%= scheduledTime %></td>
    </tr>
    <% } %>
    <% if (typeof customerAddress !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Address:</td>
      <td style="padding: 4px 0;"><%= customerAddress %></td>
    </tr>
    <% } %>
    <% if (typeof totalPrice !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Total Price:</td>
      <td style="padding: 4px 0; font-weight: 700; color: #0f172a;"><%= totalPrice %></td>
    </tr>
    <% } %>
    <% if (typeof bookingId !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Booking ID:</td>
      <td style="padding: 4px 0; font-family: monospace; font-size: 13px;"><%= bookingId %></td>
    </tr>
    <% } %>
    <% if (typeof status !== 'undefined') { %>
    <tr>
      <td style="padding: 4px 0; font-weight: 600;">Status:</td>
      <td style="padding: 4px 0;"><span style="background-color: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600;"><%= status %></span></td>
    </tr>
    <% } %>
  </table>
</div>