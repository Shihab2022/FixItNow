model Booking {
  id              String        @id @default(uuid())
  status          BookingStatus @default(REQUESTED)
  scheduledDate   DateTime
  totalPrice      Float
  customerAddress String
  notes           String?
  scheduledTime   String
  declineReason   String?
  cancellationReason String?
  paymentStatus   PaymentStatus @default(PENDING)
  customerId      String
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])

  technicianId String
  technician   TechnicianProfile   @relation("TechnicianBookings", fields: [technicianId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  payment Payment?
  review  Review?

  reminder24hSent          Boolean   @default(false)
  reminder2hSent           Boolean   @default(false)
  paymentReminderSent      Boolean   @default(false)
  reviewReminderSent       Boolean   @default(false)
  completedAt              DateTime?
  lastTechnicianRemindedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bookings")
}
